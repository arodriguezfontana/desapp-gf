PORT=3000
NODE_ENV=development

# Cadena de conexión que usa TypeORM en runtime. Fuente de verdad de host/puerto/usuario/contraseña/base.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/desapp?schema=public"

# Secreto real de firma del JWT. Generar uno propio (p. ej. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Sólo se usan si se levanta Postgres con docker-compose. DEBEN coincidir con lo que codifica DATABASE_URL.
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=desapp
POSTGRES_PORT=5432
