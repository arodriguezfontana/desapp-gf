PORT=3000
NODE_ENV=development

# Cadena de conexión que usa TypeORM en runtime. Fuente de verdad de host/puerto/usuario/contraseña/base.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/desapp?schema=public"

# Secreto real de firma del JWT. Generar uno propio (p. ej. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Primer usuario admin, creado al arrancar sólo si ADMIN_EMAIL todavía no existe (seed idempotente).
# Si el usuario ya existe, cambiar estas variables NO modifica su contraseña ni su rol.
# ADMIN_PASSWORD debe cumplir la política de contraseña: 8–16 caracteres, mayúscula, minúscula, dígito y carácter especial.
ADMIN_EMAIL=admin@desapp.com
ADMIN_PASSWORD=Admin123!

# Superusuario de mercado, creado al arrancar sólo si todavía no existe un usuario con
# username = "superuser" (seed idempotente, 020-order-matching-engine). Igual que
# contraseña. SUPERUSER_PASSWORD debe cumplir la misma política de contraseña.
SUPERUSER_EMAIL=superuser@desapp.com
SUPERUSER_PASSWORD=Superuser1!

# Bots de contraparte de la simulación interactiva de mercado (admin, POST
# /admin/simulate-market). Se crean de forma idempotente (solo si no existen
# todavía) la primera vez que corre la simulación, con username fijo y esta
# misma contraseña para los tres. No son cuentas admin.
#   bot_liquidity_1@desapp.com  (LiquidityBot)
#   bot_trader_2@desapp.com     (AlphaTraderBot)
#   bot_whale_3@desapp.com      (WhaleInvestorBot)
BOT_PASSWORD=BotSecurePass123!

# Sólo se usan si se levanta Postgres con docker-compose. DEBEN coincidir con lo que codifica DATABASE_URL.
POSTGRES_USER=USUARIO
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=desapp
POSTGRES_PORT=5432

# API Key de Football-Data.org (Plan Gratuito). Obtener en https://www.football-data.org/
FOOTBALL_DATA_API_TOKEN=your_football_data_api_token_here

# Proveedor SMTP para el envío de mails de alertas disparadas (025-player-price-alerts).
# En desarrollo/demo puede usarse un Gmail con contraseña de aplicación (MAIL_HOST=smtp.gmail.com,
# MAIL_PORT=587, MAIL_USER=tu_cuenta@gmail.com, MAIL_PASSWORD=la contraseña de aplicación de 16
# caracteres, no la contraseña normal de la cuenta) o un proveedor como Resend vía SMTP.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=CAMBIAR_POR_USUARIO_SMTP
MAIL_PASSWORD=CAMBIAR_POR_CONTRASEÑA_O_APP_PASSWORD
MAIL_FROM="DesApp Alertas <alertas@desapp.com>"

