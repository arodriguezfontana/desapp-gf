            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"Abcd1234!\"\n}"
            },
            "description": "Email generado al azar, casi seguro no registrado. Debe dar el mismo mensaje que 'password incorrecta' (indistinguible)."
          }
        },
