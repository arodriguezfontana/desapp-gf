    {
      "name": "Feature 2 — ApiKey (emisión y rotación)",
      "item": [
        {
          "name": "Emitir ApiKey — con JWT válido (201, guarda apiKey)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('cuerpo cumple el esquema { id, apiKey, createdAt }', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id').that.is.a('string');",
                  "  pm.expect(body).to.have.property('apiKey').that.matches(/^pmk_[0-9a-f]{64}$/);",
                  "  pm.expect(body).to.have.property('createdAt');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('apiKey', pm.response.json().apiKey);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/api-key", "host": ["{{baseUrl}}"], "path": ["auth", "api-key"] },
            "description": "201 Created con { id, apiKey, createdAt }. La ApiKey en texto plano solo se muestra en esta respuesta. Requiere accessToken."
          }
        },
        {
          "name": "Emitir ApiKey — rotación, invalida la anterior (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('la nueva ApiKey es distinta de la anterior', function () {",
                  "  const nueva = pm.response.json().apiKey;",
                  "  pm.expect(nueva).to.not.eql(pm.collectionVariables.get('apiKey'));",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('previousApiKey', pm.collectionVariables.get('apiKey'));",
                  "  pm.collectionVariables.set('apiKey', pm.response.json().apiKey);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/api-key", "host": ["{{baseUrl}}"], "path": ["auth", "api-key"] },
            "description": "Correr después de la request anterior. Guarda la ApiKey vieja en previousApiKey (queda revocada) — la usa 'Listar — ApiKey revocada' en Feature 3."
          }
        },
        {
          "name": "Emitir ApiKey — sin JWT (401, no crea ninguna clave)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/api-key", "host": ["{{baseUrl}}"], "path": ["auth", "api-key"] },
            "description": "Sin Authorization -> 401."
          }
        },
        {
          "name": "Emitir ApiKey — JWT malformado (401, no crea ninguna clave)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer no-es-un-jwt" }],
            "url": { "raw": "{{baseUrl}}/auth/api-key", "host": ["{{baseUrl}}"], "path": ["auth", "api-key"] },
            "description": "Token con forma/firma inválida -> 401."
          }
        }
      ]
    },
    {
      "name": "Feature 3 — Catálogo de jugadores",
      "description": "Requiere haber corrido Feature 1 (Login) y Feature 2 (Emitir ApiKey x2) antes, para tener accessToken, apiKey y previousApiKey. Desde 006-whoscored-catalog-sync los datos ya NO vienen de un seed fijo de 20 jugadores: el catálogo refleja la última sincronización exitosa con WhoScored, así que el contenido (cantidad, ligas, equipos) varía según cuándo corrió el scheduler — estos tests validan el contrato (forma, filtros, paginación, auth), no cantidades exactas. Cada jugador ahora también expone 4 métricas de rendimiento (passesCompleted/shots/interceptions/rating), con valor o null.",
      "item": [
        {
          "name": "Listar — sin filtros (200, page=1, pageSize=10, defaults)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('defaults page=1/pageSize=10, forma de la respuesta con las 4 métricas', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.pageSize).to.eql(10);",
                  "  pm.expect(body.items.length).to.be.at.most(10);",
                  "  pm.expect(body.total).to.be.at.least(body.items.length);",
                  "  body.items.forEach((p) => {",
                  "    ['passesCompleted', 'shots', 'interceptions', 'rating'].forEach((field) => {",
                  "      pm.expect(p).to.have.property(field);",
                  "    });",
                  "  });",
                  "});",
                  "if (pm.response.code === 200 && pm.response.json().items.length > 0) {",
                  "  pm.collectionVariables.set('playerId', pm.response.json().items[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": { "raw": "{{baseUrl}}/players", "host": ["{{baseUrl}}"], "path": ["players"] },
            "description": "Defaults page=1/pageSize=10. Si el catálogo está vacío (sin sincronización exitosa todavía), items=[] y total=0 es una respuesta válida (200, no error). Guarda el primer id en playerId para el folder de Detalle, si hay alguno."
          }
        },
        {
          "name": "Listar — filtro por liga (200, todos los items son de esa liga)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('todo item devuelto pertenece a la liga filtrada', function () {",
                  "  const body = pm.response.json();",
                  "  body.items.forEach((p) => pm.expect(p.league).to.eql('Premier League'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/players?league=Premier League",
              "host": ["{{baseUrl}}"],
              "path": ["players"],
              "query": [{ "key": "league", "value": "Premier League" }]
            }
          }
        },
        {
          "name": "Listar — filtro por equipo (200, todo item devuelto es de ese equipo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('todo item devuelto pertenece al equipo filtrado (match exacto insensible a mayúsculas)', function () {",
                  "  const body = pm.response.json();",
                  "  body.items.forEach((p) => pm.expect(p.team.toLowerCase()).to.eql('manchester united'.toLowerCase()));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/players?team=Manchester United",
              "host": ["{{baseUrl}}"],
              "path": ["players"],
              "query": [{ "key": "team", "value": "Manchester United" }]
            },
            "description": "'Manchester United' es sólo un ejemplo de equipo real de una de las 5 ligas soportadas; puede devolver items:[] si esa sincronización todavía no corrió — sigue siendo 200, no error."
          }
        },
        {
          "name": "Listar — filtro por posición (200, todo item devuelto es de esa posición)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
