              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('mensaje en español', function () {",
                  "  pm.expect(pm.response.json().message).to.eql([",
                  "    \"El campo 'email' debe ser un email válido.\"",
                  "  ]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Abcd1234!\"\n}"
            },
            "description": "Caso simétrico al de login ('falta un campo'), pero para register: falta 'email' por completo. El DTO sólo tiene @IsEmail() en email (sin @IsNotEmpty), así que 'undefined' dispara ese único constraint, traducido por el mecanismo global."
          }
        },
        {
          "name": "Login — credenciales válidas (200, guarda jwt)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('cuerpo cumple el esquema { accessToken, tokenType, expiresIn }', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.expiresIn).to.eql(86400);",
                  "  pm.expect(body.accessToken).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', pm.response.json().accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Abcd1234!\"\n}"
            },
            "description": "Requiere haber corrido antes 'Register — alta válida' (usa userEmail). Guarda accessToken para el resto de la colección."
          }
        },
